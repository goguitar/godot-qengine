; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but you can always edit it manually.

[configuration]

config_version=5

[application]

config/name="QEngine Guitar Pitch Demo"
config/description="Godot 4.4+ demo for QEngine – real-time guitar pitch detection via cycfi/Q (C++ GDExtension)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")

[audio]

driver/mix_rate=48000
driver/output_latency=15
bus_layout="res://default_bus_layout.tres"

[rendering]

renderer/rendering_method="forward_plus"
